# Backend environment variables
# Rename this file to .env and fill in your actual values.

# Use mongodb+srv:// if your network supports DNS SRV lookups.
# Use an Atlas database user, and URL-encode special characters in its username or password.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hw7fboy.mongodb.net/<dbname>?retryWrites=true&w=majority

# If you see querySrv ECONNREFUSED, use the standard connection string from MongoDB Atlas:
# MONGODB_URI=mongodb://<username>:<password>@cluster0-shard-00-00.hw7fboy.mongodb.net:27017,cluster0-shard-00-01.hw7fboy.mongodb.net:27017,cluster0-shard-00-02.hw7fboy.mongodb.net:27017/<dbname>?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority

JWT_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
FRONTEND_URL=http://localhost:5173
PORT=5000
